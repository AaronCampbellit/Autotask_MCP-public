# Direct-process configuration. The application does not load this automatically.
# Fixture mode needs none of these values: npm run demo
# For production, explicitly supply environment variables through approved secrets.
# Compose-specific values are in deploy/runtime.env.example.
PORT=3030
PUBLIC_URL=https://mcp.example.invalid
DATABASE_URL=
MIGRATION_DATABASE_URL=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_SCOPE=mcp.access

# Use the reviewed actual tenant zone; this sample performs no zone discovery.
AUTOTASK_BASE_URL=https://webservices1.autotask.net/atservicesrest/v1.0/
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=

# Fresh secret of at least 32 bytes, then two DISTINCT canonical base64 32-byte keys.
# Retain recovery keys separately from database/artifact backups.
CURSOR_SECRET=
OPERATION_PAYLOAD_KEY=
ARTIFACT_ENCRYPTION_KEY=

# Optional paired settings; without the pair production console login is unavailable.
ADMIN_ENTRA_CLIENT_ID=
ADMIN_ENTRA_CLIENT_SECRET=
# Exact comma-separated tenant-guid:object-guid bootstrap administrators.
ADMIN_BOOTSTRAP_IDENTITIES=

# Absolute local snapshot path; empty operations enables no live business request.
METADATA_SNAPSHOT_PATH=
ENABLED_AUTOTASK_OPERATIONS=
# Explicitly reviewed ticket URL hostnames only, comma-separated.
AUTOTASK_TICKET_HOSTS=

# All four numeric core settings plus threshold path are required together.
# Determine values from reviewed tenant allowance and reserved external usage.
AUTOTASK_REQUESTS_PER_WINDOW=
AUTOTASK_BUDGET_WINDOW_MS=
AUTOTASK_EXTERNAL_HEADROOM=
AUTOTASK_THRESHOLD_MAX_AGE_MS=
AUTOTASK_THRESHOLD_PATH=
AUTOTASK_BUDGET_MAX_WAIT_MS=
AUTOTASK_BUDGET_QUEUE_SIZE=

# Optional reviewed HTTPS /scan gateway pair; absent means file staging is disabled.
JOB_WORKER_ENABLED=true

# Application-controlled access mode; choose exact reviewed native read operations.
APPLICATION_SCOPED_READ_OPERATIONS=
OPERATIONAL_WRITES_ENABLED=false
SALES_ENABLED=false
SALES_WRITES_ENABLED=false
BUSINESS_ENABLED=false
BUSINESS_WRITES_ENABLED=false
WORK_MANAGEMENT_ENABLED=false
WORK_MANAGEMENT_WRITES_ENABLED=false
ATTACHMENTS_ENABLED=false
ATTACHMENTS_WRITES_ENABLED=false
ATTACHMENT_INTERNAL_PUBLISH_LABEL=
# Optional secret webhook binding JSON; leave unset for LAN-only deployments.
AUTOTASK_WEBHOOK_BINDINGS=

# Optional IANA timezone defaults for my_workday and ticket_prepare_visit.
# Explicit tool input wins; employee resource ID overrides the workspace.
WORKSPACE_TIMEZONE=
RESOURCE_TIMEZONES={}

# Enable only after provisioning the distinct key and persistent spool volume.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_ENCRYPTION_KEY=
# Optional rotation alternative: JSON {"active":"key-id","keys":{"key-id":"base64"}}.
# Retain old keys through the unexpired event window; leave single key blank.
DIAGNOSTICS_KEYRING=
DIAGNOSTICS_SPOOL_DIRECTORY=/app/work/diagnostics
MCP_DISCOVERY_PROFILE=full
MCP_MRTR_ENABLED=false
